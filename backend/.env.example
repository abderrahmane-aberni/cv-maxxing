# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cheapest current Gemini model as of Oct 2026. If Google renames/retires
# this, swap it here — nothing else needs to change.
GEMINI_MODEL=gemini-3.5-flash-lite

# Defaults to a local SQLite file so the project runs with zero setup.
# Swap in a Postgres URL (e.g. a free Neon database, same as the Ledger
# project) for anything beyond local dev.
DATABASE_URL=sqlite:///./resolve.db

MAX_UPLOAD_MB=5

# Optional: only used to estimate cost-per-request in the API response.
# Leave at 0 while on Gemini's free tier — there's nothing to track yet.
COST_PER_1K_INPUT=0.0
COST_PER_1K_OUTPUT=0.0

# Usage cap for a public deployment -- protects Gemini's free-tier request
# quota from strangers hitting the demo link. Irrelevant for local-only use.
RATE_LIMIT_PER_IP_PER_HOUR=5
RATE_LIMIT_GLOBAL_PER_DAY=50
